{
    "name": "eslam-reda-div/timepicker-fork-for-filament-v5",
    "description": "Filament 5.x Time Picker",
    "keywords": [
        "eslam-reda-div",
        "laravel",
        "filament",
        "filament-timepicker"
    ],
    "homepage": "https://github.com/eslam-reda-div/timepicker-fork-for-filament-v5",
    "support": {
        "issues": "https://github.com/eslam-reda-div/timepicker-fork-for-filament-v5/issues",
        "source": "https://github.com/eslam-reda-div/timepicker-fork-for-filament-v5"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Hussam Tariq",
            "email": "hu22am1@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0.0",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "EslamRedaDiv\\FilamentTimePicker\\": "src/",
            "EslamRedaDiv\\FilamentTimePicker\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EslamRedaDiv\\FilamentTimePicker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EslamRedaDiv\\FilamentTimePicker\\FilamentTimePickerServiceProvider"
            ],
            "aliases": {
                "FilamentTimePicker": "EslamRedaDiv\\FilamentTimePicker\\Facades\\FilamentTimePicker"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
